# M365 Copilot Readiness Assessment Tool - Service Principal Credentials
#
# This file is normally generated automatically by setup-service-principal.ps1.
# Copy this file to .env and fill in the values only if you are configuring
# credentials manually (e.g., using an existing app registration).
#
# DO NOT COMMIT THE REAL .env FILE TO GIT - it contains credentials.

# Azure AD / Entra tenant ID (GUID) or domain (e.g., contoso.onmicrosoft.com)
TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the Entra app registration
CLIENT_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Authentication - configure ONE of the two options below.
# ---------------------------------------------------------------------------

# Option A (preferred): certificate authentication.
# Point at a .pem or .pfx holding the private key for a certificate uploaded to
# the app registration. Preferred over a client secret because no long-lived
# secret is stored in this file.
# CERTIFICATE_PATH=C:\path\to\assessment-cert.pfx
# CERTIFICATE_PASSWORD=only-if-the-file-is-password-protected

# Option B: client secret.
# Secret value for the app registration (setup-service-principal.ps1 defaults to
# a 90 day lifetime, so this needs periodic rotation).
CLIENT_SECRET=your-client-secret-value

# Optional authoritative data-exposure reports. Separate multiple paths with a
# semicolon on Windows. A directory imports every supported CSV, TSV, JSON, and
# XLSX report in that directory.
# SAM_DAG_REPORT_PATHS=C:\Reports\SAM\site-permissions.csv;C:\Reports\SAM\sharing-links.csv
# DSPM_REPORT_PATHS=C:\Reports\Purview\data-risk-assessment.csv

# Optional SharePoint governance configuration. The default run derives the admin URL
# from the tenant's initial onmicrosoft.com domain, but renamed tenants should set it.
# SHAREPOINT_ADMIN_URL=https://contoso-admin.sharepoint.com

# SharePoint administrative PowerShell does not accept a client secret. For unattended
# collection, configure a PFX certificate uploaded to the same app registration. If these
# values are omitted, the SharePoint-only collector requests a delegated browser sign-in.
# SHAREPOINT_CERTIFICATE_PATH=C:\path\to\sharepoint-assessment.pfx
# SHAREPOINT_CERTIFICATE_PASSWORD=only-if-the-file-is-password-protected
# SHAREPOINT_CERTIFICATE_THUMBPRINT=certificate-thumbprint-in-current-user-store

# Certificate-first Purview collection. PURVIEW_ORGANIZATION is normally the initial
# tenant domain (for example contoso.onmicrosoft.com), not a SharePoint URL.
# PURVIEW_ORGANIZATION=contoso.onmicrosoft.com
# PURVIEW_CERTIFICATE_PATH=C:\path\to\purview-assessment.pfx
# PURVIEW_CERTIFICATE_PASSWORD=only-if-the-file-is-password-protected
# PURVIEW_CERTIFICATE_THUMBPRINT=certificate-thumbprint-in-current-user-store

# Optional specialized workloads (Insider Risk, Communication Compliance,
# Information Barriers, and eDiscovery) require separate roles. They are not
# queried during the normal assessment.
# PURVIEW_INCLUDE_SPECIALIZED=false

# Optional freshness policy. Permission/sharing reports and DSPM assessments use
# separate windows from content lifecycle reports. Packaged replay restores saved
# settings; --lifecycle-report-max-age-days explicitly overrides the lifecycle window.
# SAM_REPORT_MAX_AGE_DAYS=35
# DSPM_REPORT_MAX_AGE_DAYS=8
# LIFECYCLE_REPORT_MAX_AGE_DAYS=90
